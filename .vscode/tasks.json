{
    "tasks": [
        {
            "label": "CMake Build Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/Debug"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake Compile Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "CMake Build Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run Executable Debug",
            "type": "shell",
            "command": "${workspaceFolder}/build/Debug/seePlusPlus",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "dependsOn": [
                "CMake Compile"
            ],
            "problemMatcher": []
        },
        {
            "label": "Docker Build Image",
            "type": "shell",
            "command": "cd ${workspaceFolder}/; docker buildx build --platform linux/amd64,linux/arm64 -t seeplusplus/cpp-opencv .",
            "group": {
                "kind": "build",
            },
            "problemMatcher": []
        },
        {
            "label": "Docker Run Interactive",
            "type": "shell",
           "command": "docker run --rm -it ghcr.io/njm08/seeplusplus-opencv:latest",
            "group": {
                "kind": "build",
            },
            "problemMatcher": []
        },
        {
            "label": "Docker Push Image",
            "type": "shell",
            "command": "echo \"$GITHUB_TOKEN\" | docker login ghcr.io -u njm08 --password-stdin && docker buildx build --platform linux/amd64,linux/arm64 -t ghcr.io/njm08/seeplusplus-opencv:latest --push .",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}