{
    "tasks": [
        {
            "label": "Build Local Release",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tools/build_scripts/build_local_release.py"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build Local Debug",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tools/build_scripts/build_local_debug.py"
            ],
            "group": {
                "kind": "build",
            },
            "problemMatcher": []
        },
        {
            "label": "Run Local Release",
            "type": "shell",
            "command": "${workspaceFolder}/build/Local/Release/seePlusPlus",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run in Container Release",
            "type": "shell",
            "command": "docker run --rm -it --device=/dev/video0:/dev/video0 --group-add video -v ${workspaceFolder}:/app ghcr.io/njm08/seeplusplus-opencv:latest /app/build/Container/Release/seePlusPlus",
            "group": {
                "kind": "test",
            },
            "problemMatcher": []
        },
        {
            "label": "Docker Build Image",
            "type": "shell",
            "command": "cd ${workspaceFolder}/; docker buildx build --platform linux/amd64,linux/arm64 -t seeplusplus/cpp-opencv .",
            "group": {
                "kind": "build",
            },
            "problemMatcher": []
        },
        {
            "label": "Docker Run Interactive",
            "type": "shell",
           "command": "docker run --rm -it ghcr.io/njm08/seeplusplus-opencv:latest",
            "group": {
                "kind": "build",
            },
            "problemMatcher": []
        },
        {
            "label": "Docker Push Image",
            "type": "shell",
            "command": "echo \"$GITHUB_TOKEN\" | docker login ghcr.io -u njm08 --password-stdin && docker buildx build --platform linux/amd64,linux/arm64 -t ghcr.io/njm08/seeplusplus-opencv:latest --push .",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}